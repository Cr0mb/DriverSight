// DriverSight Windows Application Resource File
#include <windows.h>

// Application icon
IDI_ICON1 ICON "icon.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DriverSight"
            VALUE "FileDescription", "Kernel Driver IOCTL Vulnerability Scanner"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "DriverSight"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "DriverSight.exe"
            VALUE "ProductName", "DriverSight"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
